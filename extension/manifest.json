{
  "manifest_version": 3,
  "name": "TEMU 商品图同步助手",
  "version": "0.2.1",
  "description": "合并各颜色的英语商品图并同步详情，保留其他语言的继承设置。仅编辑当前表单，不提交商品发布。",
  "permissions": ["storage"],
  "content_scripts": [{
    "matches": ["https://agentseller.temu.com/goods/*"],
    "js": ["core.js", "adapter.js", "content.js"],
    "run_at": "document_idle"
  }]
}
